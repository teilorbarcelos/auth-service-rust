ENVIRONMENT=local

# SERVER CONFIG
PORT=8001
HOST=0.0.0.0
DEBUG=true

# DATABASE CONFIG (mesmo banco do monólito)
DATABASE_URL=postgresql://postgres:postgrespw@localhost:5432/backend_rust?schema=public

# CACHE CONFIG (mesmo Redis do monólito)
REDIS_URL=redis://127.0.0.1:6379

# AUTHENTICATION (mesma JWT_SECRET do monólito)
JWT_SECRET=super-secret-key-change-me
JWT_EXPIRES_IN=900         # 15 min
JWT_REFRESH_EXPIRES_IN=604800  # 7 dias

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
